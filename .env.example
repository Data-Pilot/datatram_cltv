# Copy to .env on each server and fill in. Never commit .env.
# Everything that differs between dev and prod. All three are required.
DEPLOY_ENV=prod                          # environment label on the Prometheus metrics (dev / prod)
PG_SCHEMA=prod_datatram                  # Postgres schema with tenants (dev_datatram / prod_datatram)
DATATRAM_BASE_URL=https://app.datatram.ai  # used by 03 (https://dev.datatram.ai / https://app.datatram.ai)

VAULT_ADDR=https://<vault-host>
VAULT_ROLE_ID=<role-id>
VAULT_SECRET_ID=<secret-id>
VAULT_KV_MOUNT=datatram

# Prometheus (OTLP/HTTP). Header value = "Basic%20" + base64("username:password").
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://<prometheus-host>/api/v1/otlp/v1/metrics
OTEL_EXPORTER_OTLP_METRICS_HEADERS=Authorization=Basic%20<base64-of-username:password>
OTEL_SERVICE_NAME=cltv-pipeline
